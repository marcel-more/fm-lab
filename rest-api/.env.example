# ============================================================
# FM-Lab REST API - Environment Configuration
# ============================================================
# Relative paths (DUCKDB_PATH, LOG_FILE, XML_*) are resolved
# against the rest-api/ directory. Template paths are resolved
# automatically to absolute paths and need not be set here.
# ============================================================

# Server Configuration
PORT=3003
# Host-safe default: binds to loopback only. In the dev container HOST is
# automatically overridden to 0.0.0.0 (devcontainer.json → remoteEnv) so the
# server is reachable from the host (port forwarding). Nothing to change.
HOST=localhost
NODE_ENV=development

# Database Configuration (local READ_ONLY copy of the master DB)
# The copy is refreshed by convert-xml after every successful import.
# Multi-solution: WITHOUT an explicit DUCKDB_PATH the API resolves
# ./db/solutions/<active solution>/fm_catalog.duckdb itself (pointer file
# .fmlab/active_solution.json). Only set this for a fixed override.
# DUCKDB_PATH=./db/fm_catalog.duckdb
# Generous: graph analysis pays off mainly on LARGE solutions → a large graph is
# the norm. The Atlas materializes the expensive ClusterEdges view (peak ~1.8 GB at
# threads=8). Tune to available RAM; DuckDB spills to disk when exceeded.
DUCKDB_MAX_MEMORY=8GB
DUCKDB_THREADS=4
# Thread cap specifically for overview/atlas queries (halves their per-query peak).
# 0/empty = no cap.
DUCKDB_OVERVIEW_THREADS=4
# Upper depth limit of the Graph Explorer (slider extension "deeper" +
# runaway cap of the depth-profile walk). GUI default stays 4; min 4.
GRAPH_MAX_DEPTH=16

# Admin endpoint protection (optional). When set, the reload endpoint must
# send a matching X-Admin-Token header. Empty = open dev access.
ADMIN_RELOAD_TOKEN=

# User annotations (noise filter & semantic enrichment). Own WRITABLE
# sidecar DB, separate from the READ_ONLY analysis copy (no lock conflict with
# convert-xml/cluster.sh). ANNOTATIONS_ENABLED=false disables the feature.
# Multi-solution: WITHOUT an explicit path the API resolves
# ../solutions/<active solution>/db/fm_annotations.duckdb itself (per-solution
# sidecar — cluster names must not bleed across solutions).
ANNOTATIONS_ENABLED=true
# ANNOTATIONS_DB_PATH=../db/fm_annotations.duckdb
# Write protection (optional, analogous to ADMIN_RELOAD_TOKEN). Header: X-Annotations-Token.
ANNOTATIONS_WRITE_TOKEN=

# Template Configuration
# TEMPLATE_DIR and TEMPLATE_CUSTOM_DIR are resolved automatically to absolute
# paths relative to environment.js. Only set when a different absolute path
# is needed, e.g.:
# TEMPLATE_DIR=/absolute/path/to/templates/sql
TEMPLATE_CACHE_ENABLED=true
TEMPLATE_CACHE_TTL=3600000

# XML Import Configuration (Parent project)
# Multi-solution: the XML inbox is per solution (solutions/<id>/xml/), resolved
# at runtime; XML_DIR is only a legacy override.
# XML_DIR=../xml
CONVERT_XML_SCRIPT=../ingestion/sql/convert_xml_01_extract.sql
CREATE_CATALOGS_SCRIPT=../ingestion/sql/convert_xml_04_catalog.sql

# Obsidian Documentation (External - absolute path)
# OBSIDIAN_VAULT_PATH=/absolute/path/to/obsidian/vault

# API Configuration
DEFAULT_LIMIT=100
MAX_LIMIT=10000
REQUEST_TIMEOUT_MS=30000

# Logging (Local to API)
LOG_LEVEL=info
LOG_FILE=./logs/api.log

# CORS
CORS_ENABLED=true
CORS_ORIGIN=*

# Plugin function documentation (MBS, etc.)
# Path to the docs/mbs directory (relative to rest-api/).
PLUGIN_DOCS_MBS_PATH=../docs/mbs
PLUGIN_DOCS_CACHE_TTL_MS=3600000
PLUGIN_DOCS_CACHE_MAX_DOCS=500
PLUGIN_DOCS_CACHE_MAX_PATHS=1000

# Reference DB (solution-independent FileMaker reference, script steps + functions
# + Claris help mirror). Attached via ATTACH AS ref READ_ONLY.
REFERENCE_DUCKDB_PATH=../reference/fm_spec.duckdb
REFERENCE_HTML_ROOT=../docs/claris-help
REFERENCE_CACHE_TTL_MS=3600000
REFERENCE_HTML_CACHE_TTL_MS=86400000
REFERENCE_DEFAULT_LANG=de

# Base URL of the web frontend for CLI deep links (fm-show skill).
# Only needed when the frontend is NOT reachable at http://localhost:5173
# (remote host, different port mapping). Read by the skill from the shell env,
# not by the server itself.
# FMLAB_WEB_URL=http://localhost:5173
