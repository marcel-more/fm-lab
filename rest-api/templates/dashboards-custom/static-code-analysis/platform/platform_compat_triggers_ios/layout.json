{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Findings",
                  "field": "finding_count",
                  "format": "number"
                },
                {
                  "label": "Does not fire",
                  "field": "not_supported",
                  "format": "number"
                },
                {
                  "label": "Partial",
                  "field": "partial_support",
                  "format": "number"
                },
                {
                  "label": "No statement",
                  "field": "no_statement",
                  "format": "number"
                },
                {
                  "label": "Affected files",
                  "field": "affected_files",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "Trigger compatibility: FileMaker Go (iOS)"
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "searchPlaceholder": "Search file, script or event…",
              "chipFilter": "severity",
              "columns": [
                {
                  "field": "severity",
                  "label": "Severity"
                },
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "trigger_event",
                  "label": "Trigger"
                },
                {
                  "field": "owner_type",
                  "label": "Attached to"
                },
                {
                  "field": "owner_name",
                  "label": "Owner"
                },
                {
                  "field": "layout_name",
                  "label": "Layout"
                },
                {
                  "field": "script_name",
                  "label": "Script"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{trigger_uuid}}",
                  "type": "ScriptTrigger",
                  "file": "{{file_name}}"
                }
              },
              "empty": {
                "message": "No trigger-compatibility findings for FileMaker Go (iOS) in scope."
              }
            }
          }
        ]
      }
    ]
  }
}
