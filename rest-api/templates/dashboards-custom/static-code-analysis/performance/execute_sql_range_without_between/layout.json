{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Findings",
                  "field": "finding_count",
                  "format": "number"
                },
                {
                  "label": "Affected files",
                  "field": "affected_files",
                  "format": "number"
                },
                {
                  "label": "ExecuteSQL calls",
                  "field": "execsql_total",
                  "format": "number"
                },
                {
                  "label": "Using BETWEEN",
                  "field": "between_count",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "ExecuteSQL range without BETWEEN"
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "searchPlaceholder": "Search file or object…",
              "columns": [
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "object_name",
                  "label": "Object"
                },
                {
                  "field": "nav_type",
                  "label": "Type"
                },
                {
                  "field": "step_no",
                  "label": "Step",
                  "align": "right",
                  "format": "number"
                },
                {
                  "field": "sql_function",
                  "label": "Function"
                },
                {
                  "field": "sql_excerpt",
                  "label": "SQL excerpt"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "{{nav_type}}",
                  "step": "{{step_uuid}}"
                }
              },
              "empty": {
                "message": "No ExecuteSQL range pattern without BETWEEN found."
              }
            }
          }
        ]
      }
    ]
  }
}
