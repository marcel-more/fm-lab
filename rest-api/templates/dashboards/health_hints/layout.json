{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "results_kpi_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "results_overview"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "results_kpi_strip",
            "props": {
              "items": [
                {
                  "label": "Checks",
                  "field": "total",
                  "format": "number",
                  "onClick": {
                    "action": "openDashboard",
                    "args": {
                      "id": "health_hints",
                      "params": {
                        "state": ""
                      }
                    }
                  }
                },
                {
                  "label": "Errors",
                  "field": "error",
                  "format": "number",
                  "onClick": {
                    "action": "openDashboard",
                    "args": {
                      "id": "health_hints",
                      "params": {
                        "state": "error"
                      }
                    }
                  }
                },
                {
                  "label": "Warnings",
                  "field": "warning",
                  "format": "number",
                  "onClick": {
                    "action": "openDashboard",
                    "args": {
                      "id": "health_hints",
                      "params": {
                        "state": "warning"
                      }
                    }
                  }
                },
                {
                  "label": "OK",
                  "field": "ok",
                  "format": "number",
                  "onClick": {
                    "action": "openDashboard",
                    "args": {
                      "id": "health_hints",
                      "params": {
                        "state": "ok"
                      }
                    }
                  }
                },
                {
                  "label": "Neutral",
                  "field": "neutral",
                  "format": "number",
                  "onClick": {
                    "action": "openDashboard",
                    "args": {
                      "id": "health_hints",
                      "params": {
                        "state": "neutral"
                      }
                    }
                  }
                },
                {
                  "label": "Pending",
                  "field": "pending",
                  "format": "number",
                  "onClick": {
                    "action": "openDashboard",
                    "args": {
                      "id": "health_hints",
                      "params": {
                        "state": "pending"
                      }
                    }
                  }
                },
                {
                  "label": "Failed",
                  "field": "failed",
                  "format": "number",
                  "onClick": {
                    "action": "openDashboard",
                    "args": {
                      "id": "health_hints",
                      "params": {
                        "state": "failed"
                      }
                    }
                  }
                },
                {
                  "label": "Findings",
                  "field": "findings_sum",
                  "format": "number"
                },
                {
                  "label": "Executed",
                  "field": "coverage"
                }
              ]
            }
          },
          {
            "type": "ResultsRunControl",
            "id": "results_run",
            "props": {
              "roots": "static-code-analysis,metadata-integrity,developer-workflow",
              "mode": "missing",
              "label": "Run all checks"
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "rp_performance_card",
        "props": {
          "span": 4,
          "title": "Performance"
        },
        "data": {
          "dataset": "results_performance"
        },
        "children": [
          {
            "type": "List",
            "id": "rp_performance_list",
            "props": {
              "rowTemplate": {
                "primary": "{{title}}",
                "secondary": "{{value}}",
                "badge": "{{state}}",
                "onClick": {
                  "action": "navigate",
                  "args": {
                    "path": "{{_open_target}}"
                  }
                }
              },
              "empty": {
                "message": "Nothing to report."
              }
            }
          }
        ]
      },
