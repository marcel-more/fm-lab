{
  "id": "health_hints",
  "version": "3.3.0",
  "featured": true,
  "badgeRoots": "static-code-analysis,metadata-integrity,developer-workflow",
  "title": "Healthchecks",
  "description": "Health of the whole solution at a glance: sums up the computed results of all check dashboards per state, grouped by rubric — each row leads to its dashboard.",
