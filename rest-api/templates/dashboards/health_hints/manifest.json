    "custom",
    "health",
    "quality"
  ],
  "entry": "layout.json",
  "datasets": [
    {
      "id": "results_overview",
      "source": "builtin:results_aggregate",
      "params": {
        "kinds": "dashboard",
        "roots": "static-code-analysis,metadata-integrity,developer-workflow"
      },
      "description": "Combined top node ('' path, row 1) + per-rubric nodes over the three check subtrees — feeds the hero KPI strip and coverage. Cache-only, never executes SQL."
    },
    {
      "id": "results_performance",
      "source": "builtin:results_list",
