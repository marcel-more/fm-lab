{
  "id": "home",
  "version": "1.4.0",
  "title": "Project overview",
  "description": "Landing page with key metrics, file overview and navigation to dashboards, tests and docs.",
  "author": "fm-lab core",
  "icon": "home",
  "tags": ["home"],
  "entry": "layout.json",
  "datasets": [
    { "id": "project_summary",       "source": "bundle:data/project_summary.sql" },
    { "id": "object_counts",         "source": "bundle:data/object_counts.sql" },
    { "id": "files_overview",        "source": "bundle:data/files_overview.sql" },
    { "id": "recent_state",          "source": "bundle:data/recent_state.sql" },
    { "id": "recent_changes",        "source": "bundle:data/recent_changes.sql" },
    { "id": "recent_sessions",       "source": "bundle:data/recent_sessions.sql" },
    { "id": "change_trend",          "source": "bundle:data/change_trend.sql" },
    { "id": "xml_directory_listing", "source": "builtin:xml_directory_listing" },
    { "id": "xml_directory_meta",    "source": "builtin:xml_directory_meta" },
    { "id": "cluster_count",         "source": "builtin:cluster_count" },
    { "id": "nav_dashboards",        "source": "builtin:list_dashboards",
      "params": { "excludeTags": ["home", "nav", "internal", "system"] } },
    { "id": "nav_tests",             "source": "builtin:list_tests" },
    { "id": "nav_docs",              "source": "builtin:list_docs" }
  ],
  "params": [
    { "name": "file", "type": "string", "required": false,
      "description": "Optional file filter — derived from the app-level filter." },
    { "name": "recent", "type": "string", "required": false,
      "description": "View of the card \"Recently changed\": objects (single changes, default) or sessions (work sessions)." }
  ],
  "permissions": { "read_only": true, "allow_navigation": true }
}
