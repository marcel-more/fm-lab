{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "todo_kpi",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "todo_kpi"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "todo_kpi_kpistrip",
            "props": {
              "items": [
                {
                  "label": "Total lines",
                  "field": "total_lines",
                  "format": "number",
                  "onClick": {
                    "action": "openDashboard",
                    "args": {
                      "id": "script_todos",
                      "params": {
                        "pattern": "",
                        "file": "{{file}}"
                      }
                    }
                  }
                },
                {
                  "label": "TO DO lines",
                  "field": "todo_lines",
                  "format": "number",
                  "onClick": {
                    "action": "openDashboard",
                    "args": {
                      "id": "script_todos",
                      "params": {
                        "pattern": "todo",
                        "file": "{{file}}"
                      }
                    }
                  }
                },
                {
                  "label": "FIX IT lines",
                  "field": "fixit_lines",
                  "format": "number",
                  "onClick": {
                    "action": "openDashboard",
                    "args": {
                      "id": "script_todos",
                      "params": {
                        "pattern": "fixit",
                        "file": "{{file}}"
                      }
                    }
                  }
                },
                {
                  "label": "TBD lines",
                  "field": "tbd_lines",
                  "format": "number",
                  "onClick": {
                    "action": "openDashboard",
                    "args": {
                      "id": "script_todos",
                      "params": {
                        "pattern": "tbd",
                        "file": "{{file}}"
                      }
                    }
                  }
                },
                {
                  "label": "Scripts",
                  "field": "scripts",
                  "format": "number"
                },
                {
                  "label": "Files",
                  "field": "files",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "todo_lines",
        "props": {
          "span": 12,
          "title": "Flagged comment lines",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "todo_lines"
        },
        "children": [
          {
            "type": "Table",
            "id": "todo_lines_table",
            "props": {
              "rowKey": "row_id",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search comments …",
              "columns": [
                {
                  "field": "file",
                  "label": "File"
                },
                {
                  "field": "name",
                  "label": "Script name"
                },
                {
                  "field": "pattern",
                  "label": "Pattern",
                  "format": "badge"
                },
                {
                  "field": "comment",
                  "label": "Comment"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{uuid}}",
                  "type": "Script",
                  "params": {
                    "sq": "{{search_term}}"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  }
}
