{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Findings",
                  "field": "finding_count",
                  "format": "number"
                },
                {
                  "label": "Custom functions",
                  "field": "custom_function_count",
                  "format": "number"
                },
                {
                  "label": "Fields",
                  "field": "field_count",
                  "format": "number"
                },
                {
                  "label": "Script steps",
                  "field": "script_step_count",
                  "format": "number"
                },
                {
                  "label": "Affected files",
                  "field": "affected_files",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "FIXME marker in a calculation comment",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search file, object or comment…",
              "columns": [
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "slot",
                  "label": "Slot"
                },
                {
                  "field": "context",
                  "label": "Object"
                },
                {
                  "field": "step_no",
                  "label": "Step"
                },
                {
                  "field": "marker",
                  "label": "Marker"
                },
                {
                  "field": "comment",
                  "label": "Comment"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "{{nav_type}}",
                  "file": "{{file_name}}",
                  "step": "{{step_uuid}}",
                  "marks": "{{marks}}",
                  "ref_src": "calc_comment_fixme",
                  "ref_msgid": "{{slot}}"
                }
              },
              "empty": {
                "message": "No FIXME markers found in calculation comments."
              }
            }
          }
        ]
      }
    ]
  }
}
