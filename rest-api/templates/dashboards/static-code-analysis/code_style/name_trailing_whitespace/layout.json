{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Findings",
                  "field": "finding_count",
                  "format": "number"
                },
                {
                  "label": "Trailing",
                  "field": "trailing_count",
                  "format": "number"
                },
                {
                  "label": "Leading",
                  "field": "leading_count",
                  "format": "number"
                },
                {
                  "label": "Both ends",
                  "field": "both_count",
                  "format": "number"
                },
                {
                  "label": "Affected files",
                  "field": "affected_files",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "Object name with leading or trailing whitespace",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Row",
            "id": "findings_filter_row",
            "props": {
              "gap": 16
            },
            "children": [
              {
                "type": "FilterChips",
                "id": "defect_filter",
                "props": {
                  "param": "defect",
                  "default": "",
                  "resetParams": [
                    "page"
                  ],
                  "options": [
                    {
                      "value": "",
                      "label": "All",
                      "countField": "finding_count"
                    },
                    {
                      "value": "trailing",
                      "label": "Trailing",
                      "countField": "trailing_count"
                    },
                    {
                      "value": "leading",
                      "label": "Leading",
                      "countField": "leading_count"
                    },
                    {
                      "value": "both",
                      "label": "Both ends",
                      "countField": "both_count"
                    }
                  ]
                },
                "data": {
                  "dataset": "summary"
                }
              }
            ]
          },
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search file, object type or name…",
              "columns": [
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "object_type",
                  "label": "Object type"
                },
                {
                  "field": "name_shown",
                  "label": "Name (bracketed)"
                },
                {
                  "field": "defect",
                  "label": "Defect"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "{{object_type}}",
                  "file": "{{file_name}}",
                  "ref_src": "name_trailing_whitespace",
                  "ref_msgid": "{{defect}}"
                }
              },
              "empty": {
                "message": "No names with leading or trailing whitespace found."
              }
            }
          }
        ]
      }
    ]
  }
}
