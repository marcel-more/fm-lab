{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Findings",
                  "field": "finding_count",
                  "format": "number"
                },
                {
                  "label": "Copy suffix",
                  "field": "copy_count",
                  "format": "number"
                },
                {
                  "label": "Numeric suffix",
                  "field": "numeric_count",
                  "format": "number"
                },
                {
                  "label": "Affected files",
                  "field": "affected_files",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "Name still carries a duplicate suffix",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Row",
            "id": "findings_filter_row",
            "props": {
              "gap": 16
            },
            "children": [
              {
                "type": "FilterChips",
                "id": "suffix_kind_filter",
                "props": {
                  "param": "suffix_kind",
                  "default": "copy",
                  "resetParams": [
                    "page"
                  ],
                  "options": [
                    {
                      "value": "all",
                      "label": "Both",
                      "countField": "total_count"
                    },
                    {
                      "value": "copy",
                      "label": "Copy suffix",
                      "countField": "copy_count"
                    },
                    {
                      "value": "numeric",
                      "label": "Numeric suffix",
                      "countField": "numeric_count"
                    }
                  ]
                },
                "data": {
                  "dataset": "summary"
                }
              },
              {
                "type": "Select",
                "id": "object_type_select",
                "props": {
                  "param": "object_type",
                  "default": "",
                  "label": "Object type",
                  "emptyOptionLabel": "All object types"
                },
                "data": {
                  "dataset": "object_types"
                }
              }
            ]
          },
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search file, object type or name…",
              "columns": [
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "object_type",
                  "label": "Object type"
                },
                {
                  "field": "object_name",
                  "label": "Object"
                },
                {
                  "field": "suffix_class",
                  "label": "Suffix"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "{{object_type}}",
                  "file": "{{file_name}}",
                  "ref_src": "name_copied_suffix",
                  "ref_msgid": "{{suffix_class}}"
                }
              },
              "empty": {
                "message": "No names carrying a duplicate suffix found."
              }
            }
          }
        ]
      }
    ]
  }
}
