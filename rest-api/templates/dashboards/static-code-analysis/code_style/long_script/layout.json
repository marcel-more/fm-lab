{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Findings",
                  "field": "finding_count",
                  "format": "number"
                },
                {
                  "label": "Affected files",
                  "field": "affected_files",
                  "format": "number"
                }
              ]
            }
          },
          {
            "type": "Slider",
            "id": "threshold_slider",
            "props": {
              "param": "min_steps",
              "label": "Minimum steps per script",
              "min": 0,
              "default": 150,
              "step": 10,
              "maxField": "max_step_count",
              "valueSuffix": "steps"
            },
            "data": {
              "dataset": "summary"
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "Long Script",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search file or script…",
              "columns": [
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "script_name",
                  "label": "Script"
                },
                {
                  "field": "step_count",
                  "label": "Steps",
                  "align": "right",
                  "format": "number"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "Script"
                }
              },
              "empty": {
                "message": "No overly long scripts found."
              }
            }
          }
        ]
      }
    ]
  }
}
