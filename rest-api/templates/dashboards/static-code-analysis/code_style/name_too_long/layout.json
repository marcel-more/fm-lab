{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Findings",
                  "field": "finding_count",
                  "format": "number"
                },
                {
                  "label": "Over threshold",
                  "field": "too_long_count",
                  "format": "number"
                },
                {
                  "label": "At the ceiling",
                  "field": "at_limit_count",
                  "format": "number"
                },
                {
                  "label": "Affected files",
                  "field": "affected_files",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "Overlong object name",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Row",
            "id": "findings_filter_row",
            "props": {
              "gap": 16
            },
            "children": [
              {
                "type": "FilterChips",
                "id": "defect_filter",
                "props": {
                  "param": "defect",
                  "default": "",
                  "resetParams": [
                    "page"
                  ],
                  "options": [
                    {
                      "value": "",
                      "label": "All",
                      "countField": "finding_count"
                    },
                    {
                      "value": "too-long",
                      "label": "Over threshold",
                      "countField": "too_long_count"
                    },
                    {
                      "value": "at-limit",
                      "label": "At the ceiling",
                      "countField": "at_limit_count"
                    }
                  ]
                },
                "data": {
                  "dataset": "summary"
                }
              },
              {
                "type": "Slider",
                "id": "max_len_slider",
                "props": {
                  "param": "max_len",
                  "label": "Name length",
                  "min": 20,
                  "max": 100,
                  "default": 80,
                  "step": 5,
                  "comparator": ">"
                },
                "data": {
                  "dataset": "summary"
                }
              },
              {
                "type": "Select",
                "id": "object_type_select",
                "props": {
                  "param": "object_type",
                  "default": "",
                  "label": "Object type",
                  "emptyOptionLabel": "All object types"
                },
                "data": {
                  "dataset": "object_types"
                }
              }
            ]
          },
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search file, object type or name…",
              "columns": [
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "object_type",
                  "label": "Object type"
                },
                {
                  "field": "object_name",
                  "label": "Object"
                },
                {
                  "field": "name_length",
                  "label": "Length"
                },
                {
                  "field": "defect",
                  "label": "Defect"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "{{object_type}}",
                  "file": "{{file_name}}",
                  "ref_src": "name_too_long",
                  "ref_msgid": "{{defect}}"
                }
              },
              "empty": {
                "message": "No names beyond the threshold found."
              }
            }
          }
        ]
      }
    ]
  }
}
