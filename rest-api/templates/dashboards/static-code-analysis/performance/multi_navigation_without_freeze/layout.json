{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Findings",
                  "field": "finding_count",
                  "format": "number"
                },
                {
                  "label": "Max navigation steps",
                  "field": "max_nav_steps",
                  "format": "number"
                },
                {
                  "label": "Affected files",
                  "field": "affected_files",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "Navigation script without Freeze Window",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Row",
            "id": "findings_filter_row",
            "props": {
              "gap": 16
            },
            "children": [
              {
                "type": "Slider",
                "id": "min_nav_slider",
                "props": {
                  "param": "min_nav",
                  "label": "Navigation steps",
                  "min": 2,
                  "max": 10,
                  "default": 3,
                  "step": 1,
                  "comparator": ">="
                },
                "data": {
                  "dataset": "summary"
                }
              }
            ]
          },
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search file or script…",
              "columns": [
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "script_name",
                  "label": "Script"
                },
                {
                  "field": "nav_steps",
                  "label": "Navigation steps",
                  "align": "right",
                  "format": "number"
                },
                {
                  "field": "called_via_psos",
                  "label": "Called via PSoS"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "Script",
                  "file": "{{file_name}}",
                  "step": "{{step_uuid}}",
                  "marks": "{{marks}}",
                  "ref_src": "multi_navigation_without_freeze",
                  "ref_msgid": "nav-no-freeze"
                }
              },
              "empty": {
                "message": "No navigation-heavy script without Freeze Window found."
              }
            }
          }
        ]
      }
    ]
  }
}
