{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Findings",
                  "field": "finding_count",
                  "format": "number"
                },
                {
                  "label": "Layout placements",
                  "field": "placement_count",
                  "format": "number"
                },
                {
                  "label": "Affected files",
                  "field": "affected_files",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "Unstored calculation with host round trip",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search file, table or field…",
              "columns": [
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "table_name",
                  "label": "Table"
                },
                {
                  "field": "field_name",
                  "label": "Field"
                },
                {
                  "field": "layout_count",
                  "label": "Layouts",
                  "align": "right",
                  "format": "number"
                },
                {
                  "field": "placement_count",
                  "label": "Placements",
                  "align": "right",
                  "format": "number"
                },
                {
                  "field": "on_list_layouts",
                  "label": "On list layouts",
                  "align": "right",
                  "format": "number"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "Field",
                  "file": "{{file_name}}",
                  "ref_src": "unstored_calc_network_function",
                  "ref_msgid": "host-round-trip"
                }
              },
              "empty": {
                "message": "No displayed unstored calculation calls Get(CurrentHostTimestamp)."
              }
            }
          }
        ]
      }
    ]
  }
}
