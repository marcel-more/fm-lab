{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Findings",
                  "field": "finding_count",
                  "format": "number"
                },
                {
                  "label": "Flush join results",
                  "field": "join_count",
                  "format": "number"
                },
                {
                  "label": "Flush external data",
                  "field": "external_count",
                  "format": "number"
                },
                {
                  "label": "Plain refreshes (not reported)",
                  "field": "plain_refresh_count",
                  "format": "number"
                },
                {
                  "label": "Affected files",
                  "field": "affected_files",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "Refresh Window flushing cached joins",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Row",
            "id": "findings_filter_row",
            "props": {
              "gap": 16
            },
            "children": [
              {
                "type": "FilterChips",
                "id": "flush_kind_filter",
                "props": {
                  "param": "flush_kind",
                  "default": "",
                  "resetParams": [
                    "page"
                  ],
                  "options": [
                    {
                      "value": "",
                      "label": "All flushes",
                      "countField": "finding_count"
                    },
                    {
                      "value": "join",
                      "label": "Join results",
                      "countField": "join_count"
                    },
                    {
                      "value": "external",
                      "label": "External data",
                      "countField": "external_count"
                    }
                  ]
                },
                "data": {
                  "dataset": "summary"
                }
              }
            ]
          },
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search file or script…",
              "columns": [
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "script_name",
                  "label": "Script"
                },
                {
                  "field": "step_nr",
                  "label": "Step",
                  "align": "right",
                  "format": "number"
                },
                {
                  "field": "flush_class",
                  "label": "Flushes"
                },
                {
                  "field": "loop_depth",
                  "label": "Loop depth",
                  "align": "right",
                  "format": "number"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "Script",
                  "file": "{{file_name}}",
                  "step": "{{step_uuid}}",
                  "ref_src": "refresh_window_flush_cache",
                  "ref_msgid": "flush-cache"
                }
              },
              "empty": {
                "message": "No Refresh Window step with a flush option found."
              }
            }
          }
        ]
      }
    ]
  }
}
