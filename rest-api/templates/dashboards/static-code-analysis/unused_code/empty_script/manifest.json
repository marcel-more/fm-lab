{
  "id": "empty_script",
  "version": "1.0.0",
  "title": "Empty Script",
  "description": "Unused-code rule — scripts with no steps at all. Usually placeholders that were never implemented.",
  "author": "fm-lab rules",
  "icon": "file-x",
  "category": "unused_code",
  "tags": [
    "rule",
    "pmd",
    "unused_code"
  ],
  "entry": "layout.json",
  "rule": {
    "severity": "info",
    "category": "unused_code",
    "rationale": "Empty scripts are noise and can be called by mistake, doing nothing.",
    "remediation": "Implement the script or delete it.",
    "meta": {
      "name": "Empty Script",
      "author": "fm-lab rules",
      "source": "fm-lab",
      "url": null,
      "description": "Unused-code rule — scripts with no steps at all. Usually placeholders that were never implemented.",
      "created": "2026-07-01",
      "references": []
    }
  },
  "analysis": {
    "objectTypes": [
      "Script"
    ],
    "outputTypes": [
      "count",
      "findings-table"
    ],
    "scope": {
      "supported": [
        "solution",
        "file",
        "object",
        "object-list",
        "cluster"
      ],
      "anchor": "nav_uuid",
      "mode": {
        "findings": "native",
        "summary": "native"
      }
    },
    "defaultResult": {
      "dataset": "summary",
      "column": "finding_count",
      "type": "number",
      "name": "finding_count",
      "meaning": "Number of findings — Empty Script"
    }
  },
  "datasets": [
    {
      "id": "summary",
      "source": "bundle:data/summary.sql"
    },
    {
      "id": "findings",
      "source": "bundle:data/findings.sql",
      "pageSize": 500
    }
  ],
  "params": [
    {
      "name": "file",
      "type": "string",
      "required": false,
      "description": "Optional file filter (from the app-level filter)."
    }
  ],
  "permissions": {
    "read_only": true,
    "allow_navigation": true
  }
}
