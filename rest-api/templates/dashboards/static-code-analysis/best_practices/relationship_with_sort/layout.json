{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Findings",
                  "field": "finding_count",
                  "format": "number"
                },
                {
                  "label": "Affected files",
                  "field": "affected_files",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "Relationship with sorted records",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Row",
            "id": "findings_filter_row",
            "props": {
              "gap": 16
            },
            "children": [
              {
                "type": "FilterChips",
                "id": "consumer_filter_chips",
                "props": {
                  "param": "consumer_filter",
                  "default": "",
                  "resetParams": ["page"],
                  "options": [
                    {
                      "value": "",
                      "label": "All relationships",
                      "countField": "finding_count"
                    },
                    {
                      "value": "portals",
                      "label": "With consumer portals",
                      "countField": "with_portals_count"
                    },
                    {
                      "value": "sorted-portals",
                      "label": "With self-sorting portals",
                      "countField": "with_sorted_portals_count"
                    }
                  ]
                },
                "data": {
                  "dataset": "summary"
                }
              }
            ]
          },
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search table occurrence…",
              "chipFilter": {
                "field": "sorted_side",
                "param": "sorted_side"
              },
              "columns": [
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "left_to",
                  "label": "Left TO"
                },
                {
                  "field": "right_to",
                  "label": "Right TO"
                },
                {
                  "field": "sorted_side",
                  "label": "Sorted"
                },
                {
                  "field": "consumer_portals",
                  "label": "Consumer portals",
                  "align": "right",
                  "format": "number"
                },
                {
                  "field": "portals_own_sort",
                  "label": "Portals with own sort",
                  "align": "right",
                  "format": "number"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "Relationship",
                  "file": "{{file_name}}"
                }
              },
              "empty": {
                "message": "No sorted relationships found."
              }
            }
          }
        ]
      }
    ]
  }
}
