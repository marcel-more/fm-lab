{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Findings",
                  "field": "finding_count",
                  "format": "number"
                },
                {
                  "label": "Affected files",
                  "field": "affected_files",
                  "format": "number"
                }
              ]
            }
          },
          {
            "type": "FilterChips",
            "id": "comment_filter",
            "props": {
              "param": "comment",
              "default": "without",
              "resetParams": [
                "page"
              ],
              "options": [
                {
                  "value": "without",
                  "label": "Without comment",
                  "countField": "count_without"
                },
                {
                  "value": "with",
                  "label": "With comment",
                  "countField": "count_with"
                }
              ]
            },
            "data": {
              "dataset": "summary"
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "Calculated field without comment",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search file, table or field…",
              "columns": [
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "table_name",
                  "label": "Table"
                },
                {
                  "field": "field_name",
                  "label": "Field"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "Field"
                }
              },
              "empty": {
                "message": "No undocumented calculated fields found."
              }
            }
          }
        ]
      }
    ]
  }
}
