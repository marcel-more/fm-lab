{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Findings",
                  "field": "finding_count",
                  "format": "number"
                },
                {
                  "label": "Affected layouts",
                  "field": "affected_layouts",
                  "format": "number"
                },
                {
                  "label": "Buttons in scope",
                  "field": "buttons_total",
                  "format": "number"
                }
              ]
            }
          },
          {
            "type": "Select",
            "id": "context_select",
            "props": {
              "param": "context",
              "default": "",
              "label": "Context",
              "emptyOptionLabel": "All contexts"
            },
            "data": {
              "dataset": "contexts"
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "Button without action",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search file, layout or object…",
              "columns": [
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "layout_name",
                  "label": "Layout"
                },
                {
                  "field": "object_name",
                  "label": "Object"
                },
                {
                  "field": "context",
                  "label": "Context"
                },
                {
                  "field": "x",
                  "label": "X"
                },
                {
                  "field": "y",
                  "label": "Y"
                },
                {
                  "field": "w",
                  "label": "Width"
                },
                {
                  "field": "h",
                  "label": "Height"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "Layout",
                  "file": "{{file_name}}",
                  "ref": "{{object_uuid}}",
                  "ref_src": "layout_button_without_action",
                  "ref_msgid": "no-action"
                }
              },
              "empty": {
                "message": "No buttons without an action found."
              }
            }
          }
        ]
      }
    ]
  }
}
