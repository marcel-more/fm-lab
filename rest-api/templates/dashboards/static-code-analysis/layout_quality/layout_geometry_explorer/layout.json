{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Objects",
                  "field": "object_count",
                  "format": "number"
                },
                {
                  "label": "Layouts",
                  "field": "layout_count",
                  "format": "number"
                },
                {
                  "label": "Files",
                  "field": "file_count",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "objects_card",
        "props": {
          "span": 12,
          "title": "Layout objects",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "objects"
        },
        "children": [
          {
            "type": "Row",
            "id": "type_filter_row",
            "props": {
              "gap": 16
            },
            "children": [
              {
                "type": "Select",
                "id": "part_select",
                "props": {
                  "param": "part",
                  "default": "",
                  "label": "Layout part",
                  "emptyOptionLabel": "All parts"
                },
                "data": {
                  "dataset": "part_types"
                }
              },
              {
                "type": "Select",
                "id": "object_type_select",
                "props": {
                  "param": "object_type",
                  "default": "",
                  "label": "Object type",
                  "emptyOptionLabel": "All object types"
                },
                "data": {
                  "dataset": "object_types"
                }
              }
            ]
          },
          {
            "type": "Row",
            "id": "size_filter_row",
            "props": {
              "gap": 16
            },
            "children": [
              {
                "type": "Slider",
                "id": "w_max_slider",
                "props": {
                  "param": "w_max",
                  "label": "Max. width",
                  "min": 0,
                  "maxField": "max_w",
                  "defaultTo": "max",
                  "comparator": "≤",
                  "step": 1,
                  "valueSuffix": "px"
                },
                "data": {
                  "dataset": "extents"
                }
              },
              {
                "type": "Slider",
                "id": "h_max_slider",
                "props": {
                  "param": "h_max",
                  "label": "Max. height",
                  "min": 0,
                  "maxField": "max_h",
                  "defaultTo": "max",
                  "comparator": "≤",
                  "step": 1,
                  "valueSuffix": "px"
                },
                "data": {
                  "dataset": "extents"
                }
              }
            ]
          },
          {
            "type": "Row",
            "id": "window_filter_row",
            "props": {
              "gap": 16
            },
            "children": [
              {
                "type": "Slider",
                "id": "x_min_slider",
                "props": {
                  "param": "x_min",
                  "label": "Window X from",
                  "min": 0,
                  "default": 0,
                  "maxField": "max_x",
                  "step": 1,
                  "valueSuffix": "px"
                },
                "data": {
                  "dataset": "extents"
                }
              },
              {
                "type": "Slider",
                "id": "x_max_slider",
                "props": {
                  "param": "x_max",
                  "label": "Window X to",
                  "min": 0,
                  "maxField": "max_x",
                  "defaultTo": "max",
                  "comparator": "≤",
                  "step": 1,
                  "valueSuffix": "px"
                },
                "data": {
                  "dataset": "extents"
                }
              },
              {
                "type": "Slider",
                "id": "y_min_slider",
                "props": {
                  "param": "y_min",
                  "label": "Window Y from",
                  "min": 0,
                  "default": 0,
                  "maxField": "max_y",
                  "step": 1,
                  "valueSuffix": "px"
                },
                "data": {
                  "dataset": "extents"
                }
              },
              {
                "type": "Slider",
                "id": "y_max_slider",
                "props": {
                  "param": "y_max",
                  "label": "Window Y to",
                  "min": 0,
                  "maxField": "max_y",
                  "defaultTo": "max",
                  "comparator": "≤",
                  "step": 1,
                  "valueSuffix": "px"
                },
                "data": {
                  "dataset": "extents"
                }
              }
            ]
          },
          {
            "type": "Table",
            "id": "objects_table",
            "props": {
              "rowKey": "row_key",
              "density": "compact",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search file, layout or object…",
              "columns": [
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "layout_name",
                  "label": "Layout"
                },
                {
                  "field": "part_type",
                  "label": "Part"
                },
                {
                  "field": "object_type",
                  "label": "Object type"
                },
                {
                  "field": "object_name",
                  "label": "Object"
                },
                {
                  "field": "nesting",
                  "label": "Level"
                },
                {
                  "field": "x",
                  "label": "X"
                },
                {
                  "field": "y",
                  "label": "Y"
                },
                {
                  "field": "w",
                  "label": "Width"
                },
                {
                  "field": "h",
                  "label": "Height"
                },
                {
                  "field": "z",
                  "label": "Z"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "Layout",
                  "file": "{{file_name}}",
                  "ref": "{{object_uuid}}"
                }
              },
              "empty": {
                "message": "No layout objects match the current filters."
              }
            }
          }
        ]
      }
    ]
  }
}
