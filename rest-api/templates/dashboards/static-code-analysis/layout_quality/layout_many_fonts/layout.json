{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Findings",
                  "field": "finding_count",
                  "format": "number"
                },
                {
                  "label": "Affected files",
                  "field": "affected_files",
                  "format": "number"
                }
              ]
            }
          },
          {
            "type": "Slider",
            "id": "threshold_slider",
            "props": {
              "param": "font_max",
              "label": "More fonts than",
              "comparator": ">",
              "min": 1,
              "max": 10,
              "step": 1,
              "default": 3,
              "valueSuffix": " fonts"
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "Layout with many fonts",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search file, layout or font…",
              "columns": [
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "layout_name",
                  "label": "Layout",
                  "breakAt": "separators"
                },
                {
                  "field": "fonts",
                  "label": "Fonts",
                  "align": "right",
                  "format": "number"
                },
                {
                  "field": "font_list",
                  "label": "Named fonts"
                },
                {
                  "field": "default_objects",
                  "label": "Objects with file default",
                  "align": "right",
                  "format": "count"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "Layout",
                  "file": "{{file_name}}",
                  "ref_src": "layout_many_fonts",
                  "ref_msgid": "many",
                  "ref_arg_count": "{{fonts}}",
                  "ref_arg_fonts": "{{font_list}}"
                }
              },
              "empty": {
                "message": "No layout with more fonts than the threshold."
              }
            }
          }
        ]
      }
    ]
  }
}
