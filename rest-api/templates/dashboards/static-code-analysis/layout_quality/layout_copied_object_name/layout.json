{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Findings",
                  "field": "finding_count",
                  "format": "number"
                },
                {
                  "label": "Copy suffix",
                  "field": "copy_suffix_count",
                  "format": "number"
                },
                {
                  "label": "Numeric suffix",
                  "field": "numeric_suffix_count",
                  "format": "number"
                },
                {
                  "label": "Duplicate names",
                  "field": "duplicate_count",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "Copied object name",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Row",
            "id": "findings_filter_row",
            "props": {
              "gap": 16
            },
            "children": [
              {
                "type": "FilterChips",
                "id": "reason_filter",
                "props": {
                  "param": "reason",
                  "default": "",
                  "resetParams": [
                    "page"
                  ],
                  "options": [
                    {
                      "value": "",
                      "label": "All reasons",
                      "countField": "finding_count"
                    },
                    {
                      "value": "copy-suffix",
                      "label": "Copy suffix",
                      "countField": "copy_suffix_count"
                    },
                    {
                      "value": "numeric-suffix",
                      "label": "Numeric suffix",
                      "countField": "numeric_suffix_count"
                    },
                    {
                      "value": "duplicate-name",
                      "label": "Duplicate names",
                      "countField": "duplicate_count"
                    }
                  ]
                },
                "data": {
                  "dataset": "summary"
                }
              },
              {
                "type": "Select",
                "id": "object_type_select",
                "props": {
                  "param": "object_type",
                  "default": "",
                  "label": "Object type",
                  "emptyOptionLabel": "All object types"
                },
                "data": {
                  "dataset": "object_types"
                }
              }
            ]
          },
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search file, layout or object…",
              "columns": [
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "layout_name",
                  "label": "Layout"
                },
                {
                  "field": "object_type",
                  "label": "Object type"
                },
                {
                  "field": "object_name",
                  "label": "Object"
                },
                {
                  "field": "reason",
                  "label": "Reason"
                },
                {
                  "field": "x",
                  "label": "X"
                },
                {
                  "field": "y",
                  "label": "Y"
                },
                {
                  "field": "w",
                  "label": "Width"
                },
                {
                  "field": "h",
                  "label": "Height"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "Layout",
                  "file": "{{file_name}}",
                  "ref": "{{object_uuid}}",
                  "ref_src": "layout_copied_object_name",
                  "ref_msgid": "{{reason}}"
                }
              },
              "empty": {
                "message": "No copied or duplicated object names found."
              }
            }
          }
        ]
      }
    ]
  }
}
