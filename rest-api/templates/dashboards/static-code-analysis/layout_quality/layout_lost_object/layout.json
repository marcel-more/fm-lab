{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Findings",
                  "field": "finding_count",
                  "format": "number"
                },
                {
                  "label": "Completely outside",
                  "field": "fully_out_count",
                  "format": "number"
                },
                {
                  "label": "Partially outside",
                  "field": "partially_out_count",
                  "format": "number"
                },
                {
                  "label": "Affected layouts",
                  "field": "affected_layouts",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "Object outside its parent",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Row",
            "id": "findings_filter_row",
            "props": {
              "gap": 16
            },
            "children": [
              {
                "type": "FilterChips",
                "id": "extent_filter",
                "props": {
                  "param": "extent",
                  "default": "",
                  "resetParams": [
                    "page"
                  ],
                  "options": [
                    {
                      "value": "",
                      "label": "All",
                      "countField": "finding_count"
                    },
                    {
                      "value": "completely",
                      "label": "Completely outside",
                      "countField": "fully_out_count"
                    },
                    {
                      "value": "partially",
                      "label": "Partially outside",
                      "countField": "partially_out_count"
                    }
                  ]
                },
                "data": {
                  "dataset": "summary"
                }
              },
              {
                "type": "Select",
                "id": "object_type_select",
                "props": {
                  "param": "object_type",
                  "default": "",
                  "label": "Object type",
                  "emptyOptionLabel": "All object types"
                },
                "data": {
                  "dataset": "object_types"
                }
              }
            ]
          },
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search file, layout or object…",
              "columns": [
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "layout_name",
                  "label": "Layout"
                },
                {
                  "field": "object_type",
                  "label": "Object type"
                },
                {
                  "field": "object_name",
                  "label": "Object"
                },
                {
                  "field": "parent_type",
                  "label": "Parent"
                },
                {
                  "field": "extent",
                  "label": "Extent"
                },
                {
                  "field": "x",
                  "label": "X"
                },
                {
                  "field": "y",
                  "label": "Y"
                },
                {
                  "field": "w",
                  "label": "Width"
                },
                {
                  "field": "h",
                  "label": "Height"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "Layout",
                  "file": "{{file_name}}",
                  "ref": "{{object_uuid}}",
                  "ref_src": "layout_lost_object",
                  "ref_msgid": "{{extent}}",
                  "ref_arg_parent": "{{parent_type}}"
                }
              },
              "empty": {
                "message": "No objects outside their parent found."
              }
            }
          }
        ]
      }
    ]
  }
}
