{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "OS-bound scripts",
                  "field": "script_count",
                  "format": "number"
                },
                {
                  "label": "Findings",
                  "field": "finding_count",
                  "format": "number"
                },
                {
                  "label": "Functions",
                  "field": "distinct_functions",
                  "format": "number"
                },
                {
                  "label": "macOS",
                  "field": "os_macos_scripts",
                  "format": "number"
                },
                {
                  "label": "Windows",
                  "field": "os_windows_scripts",
                  "format": "number"
                },
                {
                  "label": "iOS",
                  "field": "os_ios_scripts",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "OS binding via builtin functions",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search file, script or function…",
              "columns": [
                {
                  "field": "os_profile",
                  "label": "OS profile"
                },
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "script_name",
                  "label": "Script"
                },
                {
                  "field": "feature",
                  "label": "Function"
                },
                {
                  "field": "affinity",
                  "label": "Affinity"
                },
                {
                  "field": "macos",
                  "label": "macOS",
                  "format": "boolean"
                },
                {
                  "field": "windows",
                  "label": "Windows",
                  "format": "boolean"
                },
                {
                  "field": "linux",
                  "label": "Linux",
                  "format": "boolean"
                },
                {
                  "field": "ios",
                  "label": "iOS",
                  "format": "boolean"
                },
                {
                  "field": "usage_count",
                  "label": "Uses",
                  "format": "number"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "{{object_type}}"
                }
              },
              "empty": {
                "message": "No OS-bound builtin function usage in scope."
              }
            }
          }
        ]
      }
    ]
  }
}
