{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero",
          "title": "Linux delta"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Affected scripts",
                  "field": "script_count",
                  "format": "number"
                },
                {
                  "label": "Plug-in functions",
                  "field": "plugin_functions",
                  "format": "number"
                },
                {
                  "label": "Claris functions",
                  "field": "claris_functions",
                  "format": "number"
                },
                {
                  "label": "Claris steps",
                  "field": "claris_steps",
                  "format": "number"
                },
                {
                  "label": "Files",
                  "field": "affected_files",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "Works on macOS/Windows servers, not on Linux",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search file, script or feature…",
              "columns": [
                {
                  "field": "file",
                  "label": "File"
                },
                {
                  "field": "name",
                  "label": "Script"
                },
                {
                  "field": "source",
                  "label": "Source"
                },
                {
                  "field": "feature",
                  "label": "Feature"
                },
                {
                  "field": "runs_on",
                  "label": "Runs on"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "Script"
                }
              },
              "empty": {
                "message": "No Linux-blocking usage in scope — the solution's server-side surface is OS-independent."
              }
            }
          }
        ]
      }
    ]
  }
}
