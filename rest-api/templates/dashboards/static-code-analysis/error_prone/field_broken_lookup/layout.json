{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Findings",
                  "field": "finding_count",
                  "format": "number"
                },
                {
                  "label": "Lookups in scope",
                  "field": "lookups_total",
                  "format": "number"
                },
                {
                  "label": "Unverifiable",
                  "field": "unverifiable",
                  "format": "number"
                },
                {
                  "label": "Affected files",
                  "field": "affected_files",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "Broken lookup",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search file, table or field…",
              "columns": [
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "table_name",
                  "label": "Table"
                },
                {
                  "field": "field_name",
                  "label": "Field"
                },
                {
                  "field": "lookup_to",
                  "label": "Lookup relationship"
                },
                {
                  "field": "lookup_field",
                  "label": "Source field"
                },
                {
                  "field": "target_file",
                  "label": "Target file"
                },
                {
                  "field": "defect",
                  "label": "Defect"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "Field",
                  "file": "{{file_name}}",
                  "ref_src": "field_broken_lookup",
                  "ref_msgid": "{{defect}}"
                }
              },
              "empty": {
                "message": "No broken lookups found."
              }
            }
          }
        ]
      }
    ]
  }
}
