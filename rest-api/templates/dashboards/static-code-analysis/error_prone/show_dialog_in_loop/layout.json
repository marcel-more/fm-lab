{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Findings",
                  "field": "finding_count",
                  "format": "number"
                },
                {
                  "label": "Affected files",
                  "field": "affected_files",
                  "format": "number"
                }
              ]
            }
          },
          {
            "type": "FilterChips",
            "id": "scope_filter",
            "props": {
              "param": "scope",
              "default": "active",
              "resetParams": [
                "page"
              ],
              "options": [
                {
                  "value": "active",
                  "label": "Ignore inactive",
                  "countField": "count_active"
                },
                {
                  "value": "all",
                  "label": "All",
                  "countField": "count_all"
                }
              ]
            },
            "data": {
              "dataset": "summary"
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "Show Custom Dialog inside Loop",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search file or script…",
              "columns": [
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "script_name",
                  "label": "Script"
                },
                {
                  "field": "step_index",
                  "label": "Step",
                  "align": "right",
                  "format": "number"
                },
                {
                  "field": "status",
                  "label": "Status"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "Script",
                  "step": "{{step_uuid}}"
                }
              },
              "empty": {
                "message": "No Show Custom Dialog inside a Loop found."
              }
            }
          }
        ]
      }
    ]
  }
}
