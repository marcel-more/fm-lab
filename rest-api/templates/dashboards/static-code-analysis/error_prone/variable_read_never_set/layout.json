{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Findings",
                  "field": "finding_count",
                  "format": "number"
                },
                {
                  "label": "Local",
                  "field": "local_count",
                  "format": "number"
                },
                {
                  "label": "Global",
                  "field": "global_count",
                  "format": "number"
                },
                {
                  "label": "Affected scripts",
                  "field": "affected_scripts",
                  "format": "number"
                },
                {
                  "label": "Affected files",
                  "field": "affected_files",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "Variable read but never set",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Row",
            "id": "findings_filter_row",
            "props": {
              "gap": 16
            },
            "children": [
              {
                "type": "FilterChips",
                "id": "variable_scope_filter",
                "props": {
                  "param": "variable_scope",
                  "default": "",
                  "resetParams": [
                    "page"
                  ],
                  "options": [
                    {
                      "value": "",
                      "label": "All scopes",
                      "countField": "finding_count"
                    },
                    {
                      "value": "local",
                      "label": "Local",
                      "countField": "local_count"
                    },
                    {
                      "value": "global",
                      "label": "Global",
                      "countField": "global_count"
                    }
                  ]
                },
                "data": {
                  "dataset": "summary"
                }
              }
            ]
          },
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search file, variable or script…",
              "columns": [
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "variable_name",
                  "label": "Variable"
                },
                {
                  "field": "variable_scope",
                  "label": "Scope"
                },
                {
                  "field": "context",
                  "label": "First seen in"
                },
                {
                  "field": "read_count",
                  "label": "Reads"
                },
                {
                  "field": "also_set_in",
                  "label": "Also set in"
                },
                {
                  "field": "source_reliability",
                  "label": "Evidence"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "{{nav_type}}",
                  "file": "{{file_name}}",
                  "ref": "{{nav_ref}}",
                  "step": "{{step_uuid}}",
                  "marks": "{{marks}}",
                  "ref_src": "variable_read_never_set",
                  "ref_msgid": "read-never-set"
                }
              },
              "empty": {
                "message": "No variables that are read without ever being written."
              }
            }
          }
        ]
      }
    ]
  }
}
