{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "summary_card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "id": "summary_kpi",
            "props": {
              "items": [
                {
                  "label": "Findings",
                  "field": "finding_count",
                  "format": "number"
                },
                {
                  "label": "Nested open",
                  "field": "nested_open_count",
                  "format": "number"
                },
                {
                  "label": "Double close",
                  "field": "double_close_count",
                  "format": "number"
                },
                {
                  "label": "Affected files",
                  "field": "affected_files",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "findings_card",
        "props": {
          "span": 12,
          "title": "Broken comment structure in a calculation",
          "keepChildrenOnEmpty": true
        },
        "data": {
          "dataset": "findings"
        },
        "children": [
          {
            "type": "Table",
            "id": "findings_table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "pageParam": "page",
              "searchParam": "q",
              "sortParam": "sort",
              "clientMode": true,
              "searchPlaceholder": "Search file, object or formula…",
              "columns": [
                {
                  "field": "file_name",
                  "label": "File"
                },
                {
                  "field": "object_type",
                  "label": "Object type"
                },
                {
                  "field": "object_name",
                  "label": "Object"
                },
                {
                  "field": "calc_slot",
                  "label": "Slot"
                },
                {
                  "field": "location",
                  "label": "Location"
                },
                {
                  "field": "defect",
                  "label": "Defect"
                }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": {
                  "uuid": "{{nav_uuid}}",
                  "type": "{{object_type}}",
                  "file": "{{file_name}}",
                  "step": "{{step_uuid}}",
                  "ref_src": "calc_broken_comment_structure",
                  "ref_msgid": "{{defect}}"
                }
              },
              "empty": {
                "message": "No broken comment structures found."
              }
            }
          }
        ]
      }
    ]
  }
}
