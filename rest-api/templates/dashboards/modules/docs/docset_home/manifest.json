{
  "id": "docset_home",
  "version": "1.0.0",
  "title": "Docset",
  "description": "Start page for a single documentation source.",
  "author": "fm-lab core",
  "icon": "book",
  "tags": ["nav", "internal"],
  "entry": "layout.json",
  "datasets": [
    { "id": "info",       "source": "builtin:docset_info" },
    { "id": "categories", "source": "builtin:docset_categories_with_counts" }
  ],
  "params": [
    { "name": "id",   "type": "string", "required": true,
      "description": "Docset identifier (claris-help, mbs, fmide, fm-lab)." },
    { "name": "lang", "type": "string", "required": false,
      "description": "Language code for localized category names (default 'en')." }
  ],
  "permissions": { "read_only": true, "allow_navigation": true }
}
