{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "info"
        },
        "children": [
          {
            "type": "Markdown",
            "id": "info_markdown",
            "props": {
              "content": "# {{name}}\n\n{{description}}\n\n{{online_link_md}}\n\n*Languages: {{languages_display}}*"
            }
          },
          {
            "type": "KPIStrip",
            "id": "info_kpistrip",
            "props": {
              "items": [
                {
                  "label": "Categories",
                  "field": "categories",
                  "format": "number"
                },
                {
                  "label": "Entries",
                  "field": "entries",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "categories",
        "props": {
          "span": 12,
          "title": "Categories"
        },
        "data": {
          "dataset": "categories"
        },
        "children": [
          {
            "type": "List",
            "id": "categories_list",
            "props": {
              "searchParam": "q",
              "entrySearch": {
                "metaDataset": "info",
                "minChars": 3,
                "sample": 5,
                "param": "entries"
              },
              "rowTemplate": {
                "primary": "{{name}}",
                "secondary": "{{entry_count}} entries",
                "tertiary": "{{hit_sample}}",
                "badge": "{{code_ref_count}}",
                "badgeOptions": {
                  "hideZero": true,
                  "filterable": true,
                  "onClick": {
                    "action": "{{_badge_action}}",
                    "argsString": "{{_badge_action_args}}"
                  }
                },
                "onClick": {
                  "action": "{{_action}}",
                  "argsString": "{{_action_args}}"
                }
              },
              "empty": {
                "message": "No categories available for this docset."
              }
            }
          }
        ]
      }
    ]
  }
}
