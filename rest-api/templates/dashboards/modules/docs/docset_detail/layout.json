{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "info"
        },
        "children": [
          {
            "type": "Markdown",
            "id": "info_markdown",
            "props": {
              "content": "# {{name}}\n\n{{description}}\n\n[{{source_url}}]({{source_url}})\n\n*Languages: {{languages_display}}*"
            }
          },
          {
            "type": "KPIStrip",
            "id": "info_kpistrip",
            "props": {
              "items": [
                {
                  "label": "Categories",
                  "field": "categories",
                  "format": "number"
                },
                {
                  "label": "Entries",
                  "field": "entries",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "categories",
        "props": {
          "span": 12,
          "title": "Categories"
        },
        "data": {
          "dataset": "categories"
        },
        "children": [
          {
            "type": "List",
            "id": "categories_list",
            "props": {
              "rowTemplate": {
                "primary": "{{name}}",
                "secondary": "{{entry_count}} entries",
                "onClick": {
                  "action": "{{_action}}",
                  "argsString": "{{_action_args}}"
                }
              },
              "empty": {
                "message": "No categories available for this docset."
              }
            }
          }
        ]
      }
    ]
  }
}
