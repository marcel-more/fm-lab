# macOS-specific files
.DS_Store

# Environment variable files
.env
.env.local

# IDE-specific files
.vscode/
.idea/

# Log files
*.log
logs/*
!logs/.gitkeep

# Database files
*.duckdb
*.duckdb.wal
db/*
!db/.gitkeep
# Reference DBs are shipped with the repo (FileMaker function/script step reference
# and the curated plugin platform reference) — the *.duckdb glob above would
# otherwise drop them, so allow each one back in explicitly. fm_spec carries a
# version sidecar; plugin_spec embeds its version (reference_meta) and has none.
# SOURCES.md (attribution, sibling of the DBs)
!reference/fm_spec.duckdb
!reference/fm_spec.meta.json
!reference/plugin_spec.duckdb
!reference/SOURCES.md

# Solution bundles (multi-solution layout) are per-user runtime data and none of it
# is tracked: the XML inbox, the catalog DBs, the bundle manifest solution.json
# (display name, contact, metrics — regenerated on every import) and everything
# under state/ (cluster runs, last import, import logs). Tracking any of it breaks
# `git pull` on a user's checkout as soon as the app rewrites it, and the inbox of a
# non-default bundle would otherwise offer a customer's full structure export to
# `git add -A`. Only the empty inbox of the 'default' bundle ships, so a fresh clone
# has it before init ever runs — git does not descend into an excluded directory,
# hence the re-include on every level down to that .gitkeep.
solutions/*
!solutions/default/
solutions/default/*
!solutions/default/xml/
solutions/default/xml/*
!solutions/default/xml/.gitkeep

# Docs directory (loaded on demand via install skills)
docs/*
!docs/.gitkeep
!docs/agents/
!docs/agents/**
!docs/fm-lab/
!docs/fm-lab/**

# Node.js dependencies
node_modules/
# package-lock.json is COMMITTED on purpose (do not ignore it): the lockfile records
# every native optionalDependency for all OS/CPU combos (@duckdb/node-bindings-*,
# @esbuild/*, @rollup/rollup-*), so a fresh `npm install` installs the correct
# per-platform binding deterministically. Without it, npm intermittently skips the
# current platform's binding (macOS/npm 10.5.2 → MODULE_NOT_FOUND, native start crashes).

# Workspaces - build artifacts
rest-api/logs
rest-api/.env
packages/shared/dist/
packages/shared/generated/*.js
packages/shared/generated/*.d.ts
packages/shared/generated/*.map
apps/*/node_modules
apps/*/dist
apps/*/build
apps/*/.env.local
apps/*/.env.production

# Local Claude settings — .claude/settings.json is COMMITTED on purpose: it is the
# bundle's default permission seed (kept in sync from publish-assets/.claude-settings.json
# by the publisher; the devcontainer relies on it, its seed copy is fallback only).
# Only user-local overrides stay ignored.
.claude/settings.local.json
.claude/worktrees/

# .fmlab runtime state — generated/mutated at runtime, never shipped. MUST mirror the
# maintainer .gitignore: if one of these is tracked in the public repo, `git pull` on a
# user's checkout aborts as soon as the app touches it ("local changes would be
# overwritten"). Keep this block in sync with the .fmlab/ entries in the root .gitignore.
# NOTE: .fmlab/docs.json is deliberately NOT here — it ships as a tracked, catalog-only
# file (the list of available doc-sets). The runtime install-state lives in the
# gitignored .fmlab/docs.installed.json overlay instead, so pulls never conflict.
.fmlab/plugins.json
.fmlab/plugins/
.fmlab/docs.installed.json
.fmlab/user.local.json
.fmlab/last_xml_run.json
.fmlab/active_solution.json
.fmlab/contexts/
.fmlab/webbed_policy.state
.fmlab/settings.json
.fmlab/dashboards/
.fmlab/workspace/
.fmlab/stream_verify/*.snap
.fmlab/open-requests/
